              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "const corpo = pm.response.json();",
                  "pm.test(\"Histórico começa vazio\", function () { pm.expect(corpo.historico).to.eql([]); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Detalhe de ocorrência inexistente (exceção)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/ocorrencias/999999",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "ocorrencias",
                "999999"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"404 Not Found\", function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Editar ocorrência",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{base_url}}/ocorrencias/{{ocorrencia_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "ocorrencias",
                "{{ocorrencia_id}}"
              ]
            },
            "description": "Só o dono, e só enquanto a ocorrência estiver aberta.",
